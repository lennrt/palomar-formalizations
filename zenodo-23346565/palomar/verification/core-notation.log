[{"declaration":"theorem PalomarDecompression.cubicCapacity (s : Nat) (hs : LE.le 37 s) :\n  LE.le (HPow.hPow 2 (HAdd.hAdd 1 (HDiv.hDiv (HAdd.hAdd (HMul.hMul 3 s) 1) 2))) (HPow.hPow 3 (HSub.hSub s 1))","name":"PalomarDecompression.cubicCapacity"},{"declaration":"theorem PalomarDecompression.oddDegreeCapacity (k s : Nat) (hk : LE.le 2 k)\n  (hs : LE.le (HAdd.hAdd (HMul.hMul 16 (HAdd.hAdd k 1)) 1) s) :\n  LE.le (HPow.hPow 2 (HAdd.hAdd 1 (HDiv.hDiv (HAdd.hAdd (HMul.hMul (HSub.hSub (HMul.hMul 2 k) 1) s) 1) 2)))\n    (HPow.hPow (HSub.hSub (HPow.hPow 2 k) 1) (HSub.hSub s 1))","name":"PalomarDecompression.oddDegreeCapacity"},{"declaration":"theorem PalomarDecompression.markedAdviceCodec (m q slots : Nat) (hq : LT.lt 0 q)\n  (capacity : LE.le (HPow.hPow 2 (HAdd.hAdd 1 m)) (HPow.hPow q slots)) :\n  Exists fun encode =>\n    Exists fun readAdvice =>\n      Exists fun readPayload =>\n        ∀ (a : Fin 2) (p : Fin m → Fin 2),\n          And (Eq (readAdvice (encode a p)) a)\n            (And (Eq (readPayload (encode a p)) p)\n              (∀ (i : Option (Fin slots)), Iff (Eq (encode a p i) 0) (Eq i Option.none)))","name":"PalomarDecompression.markedAdviceCodec"},{"declaration":"theorem PalomarDecompression.informationLowerBound (degree bits : Nat)\n  (encode : (Set.Elem (SimpleGraph.edgeSet Top.top) → Fin 2) → Fin (HAdd.hAdd degree 1) → Fin (HPow.hPow 2 bits))\n  (decode : (Fin (HAdd.hAdd degree 1) → Fin (HPow.hPow 2 bits)) → Set.Elem (SimpleGraph.edgeSet Top.top) → Fin 2)\n  (roundtrip : ∀ (x : Set.Elem (SimpleGraph.edgeSet Top.top) → Fin 2), Eq (decode (encode x)) x) :\n  LE.le (HDiv.hDiv (HAdd.hAdd degree 1) 2) bits","name":"PalomarDecompression.informationLowerBound"},{"declaration":"theorem PalomarDecompression.largeComponentPartition.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V] (G : SimpleGraph V)\n  [DecidableRel (SimpleGraph.Adj G)] (hconn : SimpleGraph.Connected G) (id : V → Nat) (hinj : Function.Injective id)\n  (r Δ : Nat) (hdegree : ∀ (v : V), LE.le (SimpleGraph.degree G v) Δ) (hlarge : LT.lt r (Fintype.card V)) :\n  Exists fun roots =>\n    And (Finset.Nonempty roots)\n      (And\n        (∀ (a : V),\n          Membership.mem roots a →\n            ∀ (b : V), Membership.mem roots b → Ne a b → LT.lt (HMul.hMul 2 r) (SimpleGraph.dist G a b))\n        (And (∀ (v : V), Exists fun c => And (Membership.mem roots c) (LE.le (SimpleGraph.dist G c v) (HMul.hMul 2 r)))\n          (And (∀ (v : V), ExistsUnique fun c => PalomarDecompression.NearestRoot G roots id c v)\n            (And\n              (∀ (c : V),\n                Membership.mem roots c →\n                  And (LE.le (HAdd.hAdd r 1) (Finset.card (PalomarDecompression.rootCell G roots id c)))\n                    (LE.le (Finset.card (PalomarDecompression.rootCell G roots id c))\n                      (HPow.hPow (HAdd.hAdd Δ 1) (HMul.hMul 2 r))))\n              (And\n                (∀ (c v : V),\n                  PalomarDecompression.NearestRoot G roots id c v → LE.le (SimpleGraph.dist G c v) (HMul.hMul 2 r))\n                (∀ (c v : V),\n                  PalomarDecompression.NearestRoot G roots id c v →\n                    Exists fun p =>\n                      And (SimpleGraph.Walk.IsPath p)\n                        (And (Eq (SimpleGraph.Walk.length p) (SimpleGraph.dist G c v))\n                          (∀ (w : V),\n                            Membership.mem (SimpleGraph.Walk.support p) w →\n                              PalomarDecompression.NearestRoot G roots id c w))))))))","name":"PalomarDecompression.largeComponentPartition"},{"declaration":"theorem PalomarDecompression.arbitraryLabelCellGeometry.{u_1} {V : Type u_1} [Fintype V] [LinearOrder V] {q : Nat}\n  (G : SimpleGraph V) [DecidableRel (SimpleGraph.Adj G)] (hconn : SimpleGraph.Connected G) (id : V → Nat)\n  (hinj : Function.Injective id) (R Δ : Nat) (hdegree : ∀ (v : V), LE.le (SimpleGraph.degree G v) Δ)\n  (labels : V → Fin (HAdd.hAdd q 1)) (c : V) :\n  And (Iff (Finset.Nonempty (PalomarDecompression.truncatedCell G id R labels c)) (Eq (labels c) 0))\n    (And (LE.le (Finset.card (PalomarDecompression.truncatedCell G id R labels c)) (HPow.hPow (HAdd.hAdd Δ 1) R))\n      (And\n        (∀ (v : V),\n          Membership.mem (PalomarDecompression.truncatedCell G id R labels c) v →\n            Exists fun p =>\n              And (SimpleGraph.Walk.IsPath p)\n                (And (Eq (SimpleGraph.Walk.length p) (SimpleGraph.dist G c v))\n                  (And (LE.le (SimpleGraph.Walk.length p) R)\n                    (∀ (w : V),\n                      Membership.mem (SimpleGraph.Walk.support p) w →\n                        Membership.mem (PalomarDecompression.truncatedCell G id R labels c) w))))\n        (∀ (v : V), Membership.mem (PalomarDecompression.truncatedCell G id R labels c) v → Ne v c → Ne (labels v) 0)))","name":"PalomarDecompression.arbitraryLabelCellGeometry"},{"declaration":"theorem PalomarDecompression.boundedCellStability.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V] {q : Nat} (G : SimpleGraph V)\n  (hconn : SimpleGraph.Connected G) (id : V → Nat) (hinj : Function.Injective id) (R : Nat)\n  (x y : V → Fin (HAdd.hAdd q 1)) (c : V)\n  (hagree : ∀ (w : V), LE.le (SimpleGraph.dist G c w) (HMul.hMul 2 R) → Iff (Eq (x w) 0) (Eq (y w) 0)) :\n  Eq (PalomarDecompression.truncatedCell G id R x c) (PalomarDecompression.truncatedCell G id R y c)","name":"PalomarDecompression.boundedCellStability"},{"declaration":"theorem PalomarDecompression.uniformFiniteViewReconstruction (F : LocalDecompression.OrientationOracle.Rule) (T : Nat → Nat)\n  (hgood : LocalDecompression.OrientationOracle.GoodOneBitOracle F T) (k : Nat) (hk : LE.le 2 k) :\n  Exists fun decode =>\n    And\n      (∀ (n : Nat) (G : SimpleGraph (Fin n)) [inst : DecidableRel (SimpleGraph.Adj G)],\n        SimpleGraph.Connected G →\n          LT.lt (HMul.hMul 16 (HAdd.hAdd k 1)) n →\n            (∀ (v : Fin n), LE.le (SimpleGraph.degree G v) (HSub.hSub (HMul.hMul 2 k) 1)) →\n              Exists fun encode =>\n                ∀ (input : PalomarDecompression.GraphEdge G → Fin 2) (e : PalomarDecompression.GraphEdge G),\n                  And (Eq (decode n G (encode input) (Subtype.val e)) (input e))\n                    (Eq (decode n G (encode input) (Prod.swap (Subtype.val e))) (input e)))\n      (∀ (n : Nat) (G H : SimpleGraph (Fin n)),\n        SimpleGraph.Connected G →\n          SimpleGraph.Connected H →\n            ∀ (x y : Fin n → Fin (HAdd.hAdd (HSub.hSub (HPow.hPow 2 k) 1) 1)) (u v : Fin n),\n              LocalDecompression.FiniteView.SameGraphView G H u (PalomarDecompression.uniformRadius k T) →\n                (∀ (w : Fin n),\n                    LE.le (SimpleGraph.dist G u w) (PalomarDecompression.uniformRadius k T) → Eq (x w) (y w)) →\n                  Eq (decode n G x (Prod.mk u v)) (decode n H y (Prod.mk u v)))","name":"PalomarDecompression.uniformFiniteViewReconstruction"}]
