/-- One pair-aligned window: four dimensions of packed rows and the claimed
exact quality parameter. -/
structure Window where
  d1 : List Nat
  d2 : List Nat
  d3 : List Nat
  d4 : List Nat
  t : Nat
  deriving Repr, DecidableEq

/-- The rows selected by a composition from a window's four dimensions. -/
def stacked4 (d1 d2 d3 d4 : List Nat) (x : Comp4) : List Nat :=
  d1.take x.a ++ d2.take x.b ++ d3.take x.c ++ d4.take x.d

/-- Every composition of the given total selects independent rows. -/
def allIndep4 (d1 d2 d3 d4 : List Nat) (q : Nat) : Bool :=
  (comps4 q).all fun x => independent (stacked4 d1 d2 d3 d4 x)

/-- The window's rank profile matches quality parameter `t` exactly: every
total-(16-t) selection is independent and some total-(17-t) selection is not. -/
def windowExactT (w : Window) : Bool :=
  Nat.ble 1 w.t && Nat.ble w.t 16 &&
    allIndep4 w.d1 w.d2 w.d3 w.d4 (16 - w.t) &&
    !allIndep4 w.d1 w.d2 w.d3 w.d4 (17 - w.t)

/-- The pair-aligned windows of a dimension table, one claimed `t` each. -/
def buildWindows : List (List Nat) → List Nat → List Window
  | d1 :: d2 :: d3 :: d4 :: rest, t :: ts =>
      ⟨d1, d2, d3, d4, t⟩ :: buildWindows (d3 :: d4 :: rest) ts
  | _, _ => []

/-- Every pair-aligned window's rank profile matches its claimed exact `t`. -/
theorem census_every_window :
    ∀ w ∈ buildWindows allRows censusTs, windowExactT w = true := by
  sorry

/-- Exactly nine windows have `t = 4` and 336 have `t = 5`. -/
theorem census_distribution :
    censusTs.count 4 = 9 ∧ censusTs.count 5 = 336 ∧ censusTs.length = 345 := by
  sorry

end OneTwoSobolT5
