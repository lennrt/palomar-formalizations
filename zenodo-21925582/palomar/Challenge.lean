/-- The sixteen packed rows encoded by one 256-bit literal, row 0 first. -/
def unpackRows (n : Nat) : List Nat :=
  (List.range 16).map fun j => n / 2 ^ (16 * j) % 65536

/-- Top-left 16 x 16 generator rows of every OneTwo dimension, in one-based
dimension order, in the same packing as `rows25`. -/
def allRows : List (List Nat) := packedRows.map unpackRows

/-- The claimed exact quality parameter of each of the 345 pair-aligned
four-dimensional windows, in window order. -/
