[{"declaration":"theorem PalomarResults.LossyShell.endpoint_trace_equivalence {n : Nat} (x : LossyShell.Population n)\n  (ω : LossyShell.Pattern n) :\n  And (∀ (k : Nat), Eq (LossyShell.legReport x ω k) (List.getD (LossyShell.trace x ω) k 0))\n    (Eq (LossyShell.trace x ω) (List.map (LossyShell.legReport x ω) (List.range (LossyShell.aliveCount ω))))","name":"PalomarResults.LossyShell.endpoint_trace_equivalence"},{"declaration":"theorem PalomarResults.LossyShell.probability_endpoints {n : Nat} (a b : LossyShell.Population n) (h : Fin n → Nat) :\n  And (Eq (LossyShell.twoLegLaw 0 a b h) (ite (Eq 0 h) 1 0))\n    (Eq (LossyShell.twoLegLaw 1 a b h) (ite (Eq (HAdd.hAdd a b) h) 1 0))","name":"PalomarResults.LossyShell.probability_endpoints"},{"declaration":"theorem PalomarResults.LossyShell.mean_eq_iff_fold_eq {n : Nat} {p : Real} (hp : LT.lt 0 p)\n  {a b a' b' : LossyShell.Population n} :\n  Iff (Eq (LossyShell.twoLegMean p a b) (LossyShell.twoLegMean p a' b')) (Eq (HAdd.hAdd a b) (HAdd.hAdd a' b'))","name":"PalomarResults.LossyShell.mean_eq_iff_fold_eq"},{"declaration":"theorem PalomarResults.LossyShell.legs_eq_of_mean_covariance {n : Nat} {p : Real} (hp0 : LT.lt 0 p) (hp1 : LT.lt p 1)\n  {a b a' b' : LossyShell.Population n} (hmean : Eq (LossyShell.twoLegMean p a b) (LossyShell.twoLegMean p a' b'))\n  (hcov : Eq (LossyShell.twoLegCovariance p a b) (LossyShell.twoLegCovariance p a' b')) :\n  Or (And (Eq a a') (Eq b b')) (And (Eq a b') (Eq b a'))","name":"PalomarResults.LossyShell.legs_eq_of_mean_covariance"},{"declaration":"theorem PalomarResults.LossyShell.legs_eq_of_mean_covariance_sparse {n : Nat} {p : Real} (hp0 : LT.lt 0 p) (hp1 : LT.lt p 1)\n  {a b a' b' : LossyShell.Population n} (hmean : Eq (LossyShell.twoLegMean p a b) (LossyShell.twoLegMean p a' b'))\n  (hdiag : ∀ (k : Fin n), Eq (LossyShell.twoLegCovariance p a b k k) (LossyShell.twoLegCovariance p a' b' k k))\n  (hcol :\n    ∀ (m : Fin n),\n      Ne (LossyShell.imbalanceCovariance p a b m m) 0 →\n        (∀ (j : Fin n), LT.lt m j → Eq (LossyShell.imbalanceCovariance p a b j j) 0) →\n          ∀ (k : Fin n),\n            LT.lt k m → Eq (LossyShell.twoLegCovariance p a b k m) (LossyShell.twoLegCovariance p a' b' k m)) :\n  Or (And (Eq a a') (Eq b b')) (And (Eq a b') (Eq b a'))","name":"PalomarResults.LossyShell.legs_eq_of_mean_covariance_sparse"},{"declaration":"theorem PalomarResults.LossyShell.twoLegLaw_eq_iff {n : Nat} {p : Real} (hp0 : LT.lt 0 p) (hp1 : LT.lt p 1)\n  {a b a' b' : LossyShell.Population n} :\n  Iff (Eq (LossyShell.twoLegLaw p a b) (LossyShell.twoLegLaw p a' b'))\n    (Or (And (Eq a a') (Eq b b')) (And (Eq a b') (Eq b a')))","name":"PalomarResults.LossyShell.twoLegLaw_eq_iff"},{"declaration":"theorem PalomarResults.LossyShell.variance_sensitive_bounds {n : Nat} {p : Real} (hp : LE.le 0 p) (hp1 : LE.le p 1)\n  (a b : LossyShell.Population n) (k l : Fin n) (h : Nat) (ha : ∀ (i : Fin n), LE.le (@a i) h)\n  (hb : ∀ (i : Fin n), LE.le (@b i) h) :\n  And\n    (LE.le\n      (ShellResearch.expect p fun ω₁ ω₂ =>\n        HPow.hPow (HSub.hSub (↑(LossyShell.twoLegReport a b ω₁ ω₂ k)) (LossyShell.twoLegMean p a b k)) 2)\n      (HMul.hMul (HMul.hMul 2 (HPow.hPow (HMul.hMul 2 ↑h) 2)) (HSub.hSub 1 (HPow.hPow p (HAdd.hAdd (↑k) 1)))))\n    (LE.le\n      (ShellResearch.expect p fun ω₁ ω₂ =>\n        HPow.hPow\n          (HMul.hMul (HSub.hSub (↑(LossyShell.twoLegReport a b ω₁ ω₂ k)) (LossyShell.twoLegMean p a b k))\n            (HSub.hSub (↑(LossyShell.twoLegReport a b ω₁ ω₂ l)) (LossyShell.twoLegMean p a b l)))\n          2)\n      (HMul.hMul (HMul.hMul 2 (HPow.hPow (HMul.hMul 2 ↑h) 4)) (HSub.hSub 1 (HPow.hPow p (HAdd.hAdd (↑k) 1)))))","name":"PalomarResults.LossyShell.variance_sensitive_bounds"},{"declaration":"theorem PalomarResults.LossyShell.fold_recovery {n : Nat} {p : Real} (hp : LT.lt 0 p) (hp1 : LT.lt p 1)\n  (a b : LossyShell.Population n) (cHat : Fin n → Int) (μhat : Fin n → Real)\n  (haccurate :\n    ∀ (k : Fin n),\n      LE.le (abs (HSub.hSub (μhat k) (LossyShell.twoLegMean p a b k)))\n        (HDiv.hDiv (HMul.hMul (HPow.hPow p n) (HSub.hSub 1 (HPow.hPow p (HAdd.hAdd (↑k) 1)))) 5))\n  (hrounded :\n    ∀ (k : Fin n),\n      LE.le\n        (abs\n          (HSub.hSub\n            (HDiv.hDiv\n              (HSub.hSub (μhat k)\n                (Finset.sum (Finset.filter (fun i => LT.lt k i) Finset.univ) fun i =>\n                  HMul.hMul (↑(cHat i)) (LossyShell.landProb p i ↑k)))\n              (HPow.hPow p (HAdd.hAdd (↑k) 1)))\n            ↑(cHat k)))\n        (1 / 2)) :\n  Eq cHat fun i => ↑(HAdd.hAdd (@a i) (@b i))","name":"PalomarResults.LossyShell.fold_recovery"},{"declaration":"theorem PalomarResults.LossyShell.difference_recovery {n : Nat} {p : Real} (hp : LT.lt 0 p) (hp1 : LT.lt p 1)\n  (d z : Fin n → Int) (m : Fin n) (column : Fin n → Real) (hm : LT.lt 0 (d m))\n  (htop : ∀ (i : Fin n), LT.lt m i → Eq (d i) 0) (hzm : Eq (z m) (d m)) (hztop : ∀ (i : Fin n), LT.lt m i → Eq (z i) 0)\n  (haccurate :\n    ∀ (k : Fin n),\n      LT.lt k m →\n        LT.lt (abs (HSub.hSub (column k) (LossyShell.Qform p (fun i => ↑(d i)) (fun i => ↑(d i)) ↑k ↑m)))\n          (HDiv.hDiv (HMul.hMul (HPow.hPow p n) (HSub.hSub 1 (HPow.hPow p (HAdd.hAdd (↑k) 1)))) 2))\n  (hrounded :\n    ∀ (k : Fin n),\n      LT.lt k m →\n        LE.le\n          (abs\n            (HSub.hSub\n              (HDiv.hDiv\n                (HAdd.hAdd (HDiv.hDiv (column k) (HMul.hMul (↑(z m)) (HPow.hPow p (HAdd.hAdd (↑m) 1))))\n                  (Finset.sum (Finset.filter (fun i => LT.lt k i) Finset.univ) fun i =>\n                    HMul.hMul (↑(z i)) (LossyShell.landProb p i ↑k)))\n                (HSub.hSub 1 (HPow.hPow p (HAdd.hAdd (↑k) 1))))\n              ↑(z k)))\n          (1 / 2)) :\n  Eq z d","name":"PalomarResults.LossyShell.difference_recovery"},{"declaration":"theorem PalomarResults.LossyShell.all_length_designed_lower_bound (n : Nat) (hn : LE.le 2 n) {δ : Real} (N : Nat)\n  (test : (Fin N → Fin n → Nat) → Real) (ht0 : ∀ (y : Fin N → Fin n → Nat), LE.le 0 (test y))\n  (ht1 : ∀ (y : Fin N → Fin n → Nat), LE.le (test y) 1)\n  (hA :\n    LE.le\n      (Finset.sum Finset.univ fun w =>\n        HMul.hMul (ShellSampling.iidWeight (ShellSampling.roundWeight (ShellSampling.designedRate n)) N w)\n          (test fun i => ShellSampling.longReportA n (w i)))\n      δ)\n  (hB :\n    LE.le\n      (Finset.sum Finset.univ fun w =>\n        HMul.hMul (ShellSampling.iidWeight (ShellSampling.roundWeight (ShellSampling.designedRate n)) N w)\n          (HSub.hSub 1 (test fun i => ShellSampling.longReportB n (w i))))\n      δ) :\n  LE.le (HMul.hMul (HDiv.hDiv (↑n) 2) (Real.log (HDiv.hDiv 1 (HMul.hMul 2 δ)))) ↑N","name":"PalomarResults.LossyShell.all_length_designed_lower_bound"}]
